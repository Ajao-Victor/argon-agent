# Copy this file to `.env` locally. On Heroku use `heroku config:set`.
# Never commit real keys.

# --- required for infer ---
TIINGO_API_KEY=
# Path or HTTPS URL to the Colab pickle (8h LightGBM).
# MODEL_8H_PATH=models/eth_8h_lgbm.pkl
# MODEL_8H_URL=

# Optional dedicated 1h / 2h pickles. If omitted, the agent uses last-N-hour
# realized ETH % as a persistence nowcast (NOT pred_8h/8).
# MODEL_1H_PATH=models/eth_1h_lgbm.pkl
# MODEL_2H_PATH=models/eth_2h_lgbm.pkl

# --- database ---
# Heroku Postgres injects DATABASE_URL. Locally, omit it to use sqlite forecasts.db
# DATABASE_URL=postgres://user:pass@host:5432/argon
PGSSLMODE=prefer

# --- frontend CORS ---
# Production Vercel origin. Preview URLs (*.vercel.app) are already allowed.
FRONTEND_ORIGIN=https://YOUR-APP.vercel.app

# --- keeper (same EOA that is `keeper` on InferenceRegistry + ArgonVault) ---
KEEPER_PRIVATE_KEY=
DRY_RUN=true
SUBMIT_ONCHAIN=true
REBALANCE_ONCHAIN=true
ENABLE_ARBITRUM=true
ENABLE_ROBINHOOD=true

ARB_RPC=https://arb1.arbitrum.io/rpc
RH_RPC=https://rpc.mainnet.chain.robinhood.com

MODEL_ID=eth-1-2-8h-v1
GATE_1H_BPS=100
GATE_2H_BPS=250
GATE_8H_BPS=200
TICK_HALF_WIDTH=200

REGISTRY_ADDRESS=0xbAf00c0aCa440337d43495c7de661A0AC2E01e8f
VAULT_ADDRESS=0x9F844b4D1b28Be7413067f9d4fC08Bc276fd1C60
ADAPTER_ADDRESS=0xECCc4B8946D0DB206f977d3021544D0cD5Dc69D4
